# ================================================================
# PostgreSQL Connection Configuration
# You can use a 100% free PostgreSQL database from Neon (neon.tech)
# or Supabase (supabase.com), Render (render.com), Railway, etc.
# ================================================================

# Example Neon.tech connection string:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sweet-dawn-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Example Local PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yourpath_db

DATABASE_URL=
PORT=3000

# ================================================================
# Registration confirmation email (optional)
# ================================================================
# When these are set, a confirmation email is sent to the address used
# to register. For Gmail use an App Password (Google Account -> Security
# -> 2-Step Verification -> App passwords), NOT your normal password.
# Without SMTP settings the confirmation message is only logged.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.address@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="YourPath. <your.address@gmail.com>"

